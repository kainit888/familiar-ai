# ──────────────────────────────────────────
# familiar-ai configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────

# HuggingFace (optional)
# Suppresses rate-limit warnings from the embedding model download.
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# Main LLM backend (required)
# PLATFORM: anthropic | gemini | openai | kimi | glm | cli
PLATFORM=anthropic
# Unified API key for the selected PLATFORM
API_KEY=sk-ant-...

# Model to use (optional)
# Anthropic default: claude-haiku-4-5-20251001
# Gemini default: gemini-2.5-flash
# OpenAI default: gpt-4o-mini
MODEL=claude-haiku-4-5-20251001

# Legacy compatibility:
# ANTHROPIC_API_KEY / ANTHROPIC_MODEL are still read if present, but new writes
# should use PLATFORM / API_KEY / MODEL.

# Thinking mode (optional, default: auto)
# "auto"     = adaptive thinking for claude-sonnet-4/opus-4, disabled for others
# "adaptive" = always use adaptive thinking (Sonnet 4.x / Opus 4.x only)
# "extended" = extended thinking with fixed budget (see THINKING_BUDGET_TOKENS)
# "disabled" = no thinking
# THINKING_MODE=auto

# Effort level for adaptive thinking (default: high)
# "max"    = always think deeply, no constraints (Opus 4.6 only)
# "high"   = always think (default)
# "medium" = moderate thinking, may skip for simple queries
# "low"    = minimize thinking, skip for simple tasks
# THINKING_EFFORT=high

# Budget tokens for extended thinking mode (default: 10000)
# Only used when THINKING_MODE=extended
# THINKING_BUDGET_TOKENS=10000

# ──────────────────────────────────────────
# Camera — ONVIF/RTSP compatible Wi-Fi camera (optional)
# Gives your familiar eyes that can look around.
# Works with any camera that supports ONVIF + RTSP (tested with Tapo C220).
#
# ⚠️  Tapo / TP-Link users: you must create a "local account" in the Tapo app
#     (Device Settings → Advanced → Camera Account) before this will work.
#     Your TP-Link cloud account credentials will NOT work here.
# ──────────────────────────────────────────
CAMERA_HOST=192.168.1.xxx
CAMERA_USERNAME=admin
CAMERA_PASSWORD=your-camera-password
CAMERA_ONVIF_PORT=2020

# Optional PTZ overrides when your RTSP stream endpoint differs from the
# ONVIF/PTZ control endpoint. Leave unset to fall back to the CAMERA_* values above.
# CAMERA_PTZ_HOST=192.168.1.xxx
# CAMERA_PTZ_USERNAME=admin
# CAMERA_PTZ_PASSWORD=your-ptz-password
# CAMERA_PTZ_PORT=2020

# ──────────────────────────────────────────
# Robot vacuum — Tuya (optional)
# Gives your familiar legs to roam the room.
# Get API credentials at https://iot.tuya.com/
# ──────────────────────────────────────────
TUYA_REGION=us
TUYA_API_KEY=your-tuya-key
TUYA_API_SECRET=your-tuya-secret
TUYA_DEVICE_ID=your-device-id

# ──────────────────────────────────────────
# ElevenLabs TTS (optional)
# Gives your familiar a voice.
# Get your key at https://elevenlabs.io/
# Find voice IDs at https://elevenlabs.io/voice-library
# pico_v3 注: 実際の発話は go2rtc → Tapo C210 経路 (下記 GO2RTC_URL) で行われ、
#   ElevenLabs キーは say の発話には未使用。say ツールの登録は
#   「ELEVENLABS_API_KEY または GO2RTC_URL のいずれか」で有効化される
#   (config.TTSConfig.has_voice_output)。GO2RTC_URL は既定で非空のため、
#   ElevenLabs キー無しでも say は使える。ELEVENLABS_API_KEY は Realtime STT
#   (下記 Scribe v2) では引き続き必要。
# ──────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9

# ──────────────────────────────────────────
# Realtime STT (optional)
# Always-on, hands-free voice input using ElevenLabs Scribe v2 Realtime.
# Streams microphone audio over WebSocket; VAD auto-commits transcripts.
# Requires ELEVENLABS_API_KEY above.
# ──────────────────────────────────────────
REALTIME_STT=false

# ──────────────────────────────────────────
# Continuous STT (Tapo RTSP / Kotoba-Whisper, pico_v3 Phase C-Ctrl+T 常時化)
# Tapo C210 RTSP 音声トラックを常時購読し、無音区切りで Kotoba-Whisper に投げて
# 1 発話ずつ TUI へ流す (ハンズフリー)。TUI 起動時から常時 ON。
# Ctrl+T で一時停止 / 再開できる。RTSP URL は STT_RTSP_URL または CAMERA_* から。
# false / 0 / no / off で無効化 (既定 ON)。
# ──────────────────────────────────────────
# CONTINUOUS_STT=true

# ──────────────────────────────────────────
# ElevenLabs STT — voice input (optional)
# Reuses ELEVENLABS_API_KEY above — no extra key needed.
# Press Ctrl+M in the TUI to start/stop recording.
# ──────────────────────────────────────────
# STT_LANGUAGE=ja    # BCP-47 language code for batch + realtime transcription (default: ja)

# ──────────────────────────────────────────
# Coding agent tools (optional)
# Gives your familiar the ability to read and modify code files.
# ──────────────────────────────────────────
# Root directory for file operations (default: current working directory).
# All relative paths in read_file/edit_file/glob/grep are resolved from here.
# CODING_WORKDIR=/home/user/my-project

# Enable the bash tool (DISABLED by default for safety).
# Set to "true" only if you trust the agent to run shell commands.
# CODING_BASH=false

# ──────────────────────────────────────────
# go2rtc — Tapo C210 speaker playback (Phase C-3 確定)
# pico_v3 adapter 経由で TTS 音声を Tapo C210 内蔵スピーカーから再生する。
# Tapo は ONVIF Profile S のみのため、go2rtc 経由で Tapo 独自プロトコルを叩く。
#
# 仕様 (カイニットの実機検証で確定 2026-05-19):
#   - メイン PC 上の go2rtc (192.168.10.104:1984) に POST する
#   - エンドポイント:
#       POST {GO2RTC_BASE_URL}/api/streams?dst={TAPO_STREAM_NAME}&src=<URL-encoded ffmpeg URL>
#     src 形式: ffmpeg:<wav_path>#audio=pcma#input=file
#   - Body 空、Authorization なし、LAN 内認証なし
#   - 事前に RPi5 ホスト側で ffmpeg 前処理 (volume / 16kHz / mono / apad) を実行
#
# go2rtc.yaml 設定例 (メイン PC 上):
#   streams:
#     tapo_c210:
#       - tapo://TP-LinkクラウドパスワードMD5@192.168.10.110
#
# 旧キー GO2RTC_URL / GO2RTC_STREAM は Phase C-3 で廃止。新キーへ移行済み。
# 旧キー GO2RTC_ENABLED は Phase C-5 (v5) で完全廃止 (HTTP API 単一経路に統一、14-5-11)。
# ──────────────────────────────────────────
# GO2RTC_BASE_URL=http://192.168.10.104:1984    # デフォルト: http://192.168.10.104:1984
# TAPO_STREAM_NAME=tapo_c210                    # go2rtc.yaml の streams キーと一致させる

# Phase C-7: go2rtc HTTP pull 方式パラメータ。
# go2rtc (メイン PC) は ffmpeg:<url>#input=file で WAV を HTTP 取得するため、
# Pi 側で小さな WAV 配信サーバ (aiohttp.web) を 0.0.0.0:<TTS_SERVE_PORT> に立て、
# http://<TTS_PI_SELF_IP>:<TTS_SERVE_PORT>/xxxx.wav として公開する。
# TTS_SERVE_PORT=50021         # Pi 側 WAV 配信サーバの待受ポート (デフォルト 50021)
# TTS_PI_SELF_IP=192.168.10.109  # go2rtc が pull しに来る Pi 自身の LAN IP
# TTS_DELETE_DELAY_SEC=30      # 配信 WAV 遅延削除秒の下限 floor (go2rtc pull 猶予、デフォルト 30)
# Phase C-8.1: 削除 delay を再生時間ベースで動的算出 (長文 not-found レース防止)。
# delay = max(floor, 再生秒 * TTS_DELETE_SAFETY + TTS_DELETE_MARGIN_SEC)。
# TTS_DELETE_SAFETY=1.5        # 再生時間に掛ける安全係数 (デフォルト 1.5)
# TTS_DELETE_MARGIN_SEC=10     # 上乗せ固定マージン秒 (デフォルト 10.0)

# TTS 前処理 (ffmpeg 経由) パラメータ (Phase C-3 確定)
# TTS_VOLUME=0.5             # ffmpeg volume フィルタ係数 (デフォルト 0.5)
# TTS_PRE_RESAMPLE=16000     # Tapo PCMA 用の再サンプリング rate (デフォルト 16000)
# TTS_TAIL_SILENCE=0.5       # 末尾に詰める無音長 (秒、デフォルト 0.5)

# テキスト分割パラメータ (Phase C-3 確定)
# TTS_CHUNK_MAX_CHARS=30     # 1 チャンク最大文字数 (デフォルト 30)
# TTS_CHUNK_DELAY_MS=0       # チャンク間のディレイ ms (デフォルト 0)

# SBV2 モデル名 (Phase C-3 確定、jvnv-F1-jp 常時 load 済み前提)
# TTS_MODEL_NAME=jvnv-F1-jp

# ──────────────────────────────────────────
# pico_v3 adapter 層 (Phase C-1)
# 外部 PC 上のサーバを HTTP で叩く。未設定時はメイン PC (192.168.10.104)
# のデフォルトポートにフォールバック。
# ──────────────────────────────────────────
# Style-BERT-VITS2 TTS サーバ (公式 API: GET /voice?text=...)
# TTS_BASE_URL=http://192.168.10.104:5000
# TTS_TIMEOUT_SEC=60

# Kotoba-Whisper STT サーバ (POST /transcribe で multipart/form-data)
# STT_BASE_URL=http://192.168.10.104:8765/transcribe
# STT_TIMEOUT_SEC=60

# ──────────────────────────────────────────
# STT RTSP 購読 (Phase C-4 確定)
# Tapo C210 の RTSP 音声トラックを ffmpeg で連続購読し、silencedetect で発話を
# 区切って Kotoba-Whisper に投げる常駐タスクのパラメータ。
#
# RTSP URL の解決順:
#   1. STT_RTSP_URL が設定されていればそれを優先 (完全上書き)
#   2. 未設定なら CAMERA_USERNAME:CAMERA_PASSWORD@CAMERA_HOST:554/stream1 を組み立て
#   3. いずれも揃わなければ no-op (購読タスクは起動するが即終了)
#
# VAD バックエンド: planner 確定で ffmpeg silencedetect 採用 (uv add 不要、aarch64 wheel 不要)
# ──────────────────────────────────────────
# STT_RTSP_URL=rtsp://pico_cam:password@192.168.10.110:554/stream1  # 完全上書き用
# STT_VAD_BACKEND=ffmpeg          # 'ffmpeg' (default) | 'disabled'。将来 'webrtcvad' 等を追加予定
# STT_VAD_NOISE_DB=-30dB          # silencedetect の noise 閾値 (例: -30dB / -40dB)
# STT_VAD_MIN_SILENCE_SEC=0.5     # 発話終端と判定する無音秒数
# STT_VAD_MAX_SEGMENT_SEC=15.0    # 1 発話セグメントの上限秒、超えたら強制 flush
# STT_VAD_MIN_SEGMENT_SEC=0.3     # これ未満は無音/ノイズ扱い、whisper に投げない
# STT_FFMPEG_RESTART_BACKOFF_SEC=5.0  # ffmpeg 異常終了時の再起動待機秒

# STT 幻聴 (hallucination) フィルタ (Phase C-13)
# Whisper Large が無音/雑音で動画アウトロ定型句 (「ご視聴ありがとうございました」
# 「ありがとうございました」「ごめん」等) を頻発させるため、on_speech() に届く前に
# Pi5 側テキスト層で silent-drop する。denylist + allowlist(完全一致優先) + 単一文字。
# false / 0 / no / off で無効化 (既定 ON)。
# STT_HALLUCINATION_FILTER=true

# qwen3-vl Vision (Ollama OpenAI 互換エンドポイント)
# VISION_BASE_URL=http://192.168.10.104:11434/v1
# VISION_MODEL=qwen3-vl:4b
# VISION_TIMEOUT_SEC=60

# ── Utility LLM backend (optional) ───────────────────────────────────────
# Separate LLM for non-conversation tasks: day summaries, emotion inference,
# self-model updates, conversation compaction, etc.
# Falls back to the main PLATFORM/API_KEY/MODEL when not set.
#
# Example: conversation on Kimi, utilities on Claude Haiku
#   PLATFORM=kimi
#   API_KEY=<moonshot-key>
#   UTILITY_PLATFORM=anthropic
#   UTILITY_API_KEY=<anthropic-key>
#   UTILITY_MODEL=claude-haiku-4-5-20251001
#
# UTILITY_PLATFORM=anthropic
# UTILITY_API_KEY=sk-ant-...
# UTILITY_MODEL=claude-haiku-4-5-20251001
#
# OpenAI 互換エンドポイントに向ける場合 (Ollama / vllm / lm-studio 等):
#   UTILITY_PLATFORM=openai
#   UTILITY_API_KEY=ollama
#   UTILITY_MODEL=qwen2.5:1.5b
#   UTILITY_BASE_URL=http://localhost:11434/v1
# UTILITY_BASE_URL=
#
# Phase C-11: utility を LiteRT-LM + Gemma 4 E2B に向ける場合
# (pico_agent.litert_server を localhost:11435 で起動 = OpenAI 互換):
#   UTILITY_PLATFORM=openai
#   UTILITY_API_KEY=litert          # 任意の非空文字列で可 (鍵不要)
#   UTILITY_MODEL=gemma-4-e2b
#   UTILITY_BASE_URL=http://localhost:11435/v1
#   UTILITY_TIMEOUT_S=60

# ── LiteRT utility server (pico_agent.litert_server, Phase C-11) ──────────
# 上記 UTILITY_BASE_URL を LiteRT に向ける場合に必要なサーバ側設定。
# .litertlm モデルファイルへの安定パス (snapshot hash 直指定を避ける symlink 推奨)。
# LITERT_MODEL_PATH=/home/pico/litert_models/gemma-4-E2B/gemma-4-E2B-it.litertlm
# LITERT_LISTEN_PORT=11435

# ── Scene LLM backend (optional) ──────────────────────────────────────
# Separate LLM dedicated to scene entity extraction (cheaper/local model).
# Falls back to UTILITY backend (then main backend) when not configured.
#
# OpenAI 互換 (Ollama 等) 例:
#   SCENE_PLATFORM=openai
#   SCENE_API_KEY=ollama
#   SCENE_MODEL=qwen2.5:1.5b
#   SCENE_BASE_URL=http://192.168.10.104:11434/v1
# SCENE_BASE_URL=

# ── Alternative LLM backends ───────────────────────────────────────────────────
# Set PLATFORM to switch from the default Anthropic backend.
#
# Z.AI GLM (https://api.z.ai)
#   PLATFORM=glm
#   API_KEY=<your-key>            # get at https://bigmodel.cn/
#   MODEL=glm-4.6v                # default (vision); glm-4.7/glm-4.5/glm-5 = text-only
#
# Moonshot AI Kimi (https://platform.moonshot.ai)
#   PLATFORM=kimi
#   API_KEY=<your-moonshot-key>
#   MODEL=kimi-k2.5
#
# Google Gemini
#   PLATFORM=gemini
#   API_KEY=<your-gemini-key>
#   MODEL=gemini-2.5-flash
#
# OpenAI / local (Ollama, vllm, LM Studio …)
#   PLATFORM=openai
#   API_KEY=<your-openai-key>
#   BASE_URL=http://localhost:11434/v1   # omit for real OpenAI
#   MODEL=gpt-4o-mini
#   TOOLS_MODE=native                   # or "prompt" for local models

# ── Autonomous behavior (default: all OFF) ────────────────────────────────────
# By default, the agent only responds when spoken to and uses say() explicitly.
# Enable autonomous actions with these flags:
#
# FAMILIAR_AUTO=1               # enable ALL autonomous behavior
# FAMILIAR_AUTO_DESIRE=1        # enable desire-driven idle turns only
# FAMILIAR_AUTO_SAY=1           # enable auto-say (fallback vocalization) only
#
# pico_v3 Phase X Stage A: 視覚自走を有効化するには FAMILIAR_AUTO_DESIRE=true。
# 個別 drive を無効化したい場合 (暴走時など) はカンマ区切りで列挙する:
# FAMILIAR_DISABLED_DRIVES=look_around,explore   # 既定: 空 (= 全 drive 有効)
#   名前は desires.py の DriveSpec 名 (look_around / explore / greet_companion /
#   attachment / curiosity / worry_companion 等)。空白・大小は正規化される。

# ── Performance tuning (optional) ─────────────────────────────────────────────
# FAMILIAR_TAPE_LLM_REPLAN=1   # use LLM for TAPE replanning (default: heuristic)
# FAMILIAR_COHERENCE_CHECK=1   # enable response coherence check (extra LLM call)

# ── MCP (Model Context Protocol) ──────────────────────────────────────────────
# Optional: Connect external MCP servers to extend the agent's tools.
# Body tools (camera, TTS, mobility) stay built-in. Use MCP for everything else.
#
# Config file (same mcpServers format as Claude Code's ~/.claude.json):
#   default: ~/.familiar-ai.json
#
# Example ~/.familiar-ai.json:
#   {
#     "mcpServers": {
#       "filesystem": {
#         "type": "stdio",
#         "command": "npx",
#         "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/user"]
#       }
#     }
#   }
#
# MCP_CONFIG=/path/to/custom-mcp-config.json   # override default path
